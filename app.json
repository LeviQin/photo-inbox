{
  "expo": {
    "name": "图序",
    "slug": "photo-inbox",
    "version": "1.3.1",
    "orientation": "portrait",
    "scheme": "photoinbox",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/logo.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.photoinbox",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "图序需要读取照片，用于本地整理、分类和搜索。",
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.expo.modules.backgroundtask.processing"
        ]
      }
    },
    "android": {
      "package": "com.example.photoinbox",
      "versionCode": 8,
      "icon": "./assets/logo.png",
      "permissions": [
        "READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "允许图序访问照片，用于本地整理、分类和搜索。",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sqlite",
      "expo-background-task",
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ]
    ]
  }
}
