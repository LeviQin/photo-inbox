{
  "name": "photo-inbox",
  "version": "1.3.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node --experimental-strip-types --experimental-default-type=module --test tests/*.test.mjs",
    "benchmark": "node --expose-gc --experimental-strip-types --experimental-default-type=module scripts/benchmark-library.mjs",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "build:android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-android-apk.ps1",
    "prebuild": "expo prebuild",
    "clean": "node ./scripts/clean.js",
    "validate": "node ./scripts/validate-project.js"
  },
  "dependencies": {
    "@shopify/flash-list": "^2.0.2",
    "expo": "^57.0.0",
    "expo-background-task": "~57.0.14",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.16",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.19",
    "expo-linking": "~57.0.8",
    "expo-media-library": "~57.0.4",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.9",
    "typescript": "~6.0.3"
  }
}
